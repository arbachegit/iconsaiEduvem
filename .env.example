# =====================================================================
# iconsaiEduven — environment variables
# Copie para .env.local e preencha. NUNCA commitar .env.local.
# =====================================================================

# --- Supabase (hoje: banco do iconsaiIcon — projeto hvynozijedvjjhnrtpzs) ---
SUPABASE_URL=https://hvynozijedvjjhnrtpzs.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=eduven

# --- LLM ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Auth (hoje: tools-auth gate; futuro: standalone) ---
AUTH_MODE=tools
TOOLS_VERIFY_URL=https://icon.iconsai.ai/icon/api/tools-auth/verify
TOOLS_LOGIN_URL=https://icon.iconsai.ai/icon/tools?reason=auth
SESSION_COOKIE_NAME=course_session_eduven
ADMIN_SESSION_COOKIE_NAME=course_admin_session_eduven

# --- Deploy (parametrizado para futuro droplet próprio) ---
DEPLOY_HOST=104.236.28.58
DEPLOY_PATH=/opt/eduven/app
DEPLOY_PORT=3010
DEPLOY_DOMAIN=eduven.iconsai.ai
DEPLOY_SERVICE=eduven
