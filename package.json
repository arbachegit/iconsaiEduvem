    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "17.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
